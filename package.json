{
  "name": "opencode-feature-map",
  "version": "0.2.0",
  "private": true,
  "description": "OpenCode plugin that makes an agent read a project's feature map (docs/features/) before its source: six tools, six commands, a once-per-session guard, and an HTML map format with a Markdown upgrade path",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs .",
    "measure": "node scripts/measure.mjs .",
    "plugin:install": "node scripts/install.mjs",
    "plugin:install:project": "node scripts/install.mjs --project",
    "plugin:uninstall": "node scripts/install.mjs --remove"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.26"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
